{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "rea-captcha": ["./src/index.ts"],
      "rea-captcha/playwright": ["./src/browser/playwright.ts"],
      "rea-captcha/cdp": ["./src/browser/cdp.ts"],
      "rea-captcha/jet-browser": ["./src/browser/jet-browser.ts"],
      "rea-captcha/jet-standalone": ["./src/browser/jet-standalone.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "examples/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
