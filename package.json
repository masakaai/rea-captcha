{
  "name": "rea-captcha",
  "mcpName": "io.github.masakaai/rea-captcha",
  "version": "0.1.0",
  "description": "Local-first verification challenge intelligence and human handoff for browser agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masakaai/rea-captcha.git"
  },
  "homepage": "https://github.com/masakaai/rea-captcha#readme",
  "bugs": {
    "url": "https://github.com/masakaai/rea-captcha/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.16.0",
  "bin": {
    "rea-captcha": "scripts/rea-captcha.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/browser/playwright.d.ts",
      "import": "./dist/browser/playwright.js"
    },
    "./cdp": {
      "types": "./dist/browser/cdp.d.ts",
      "import": "./dist/browser/cdp.js"
    },
    "./jet-browser": {
      "types": "./dist/browser/jet-browser.d.ts",
      "import": "./dist/browser/jet-browser.js"
    },
    "./jet-standalone": {
      "types": "./dist/browser/jet-standalone.d.ts",
      "import": "./dist/browser/jet-standalone.js"
    },
    "./model-runtime": {
      "types": "./dist/model/python-ocr-runtime.d.ts",
      "import": "./dist/model/python-ocr-runtime.js"
    },
    "./mcp": {
      "types": "./dist/server/mcp.d.ts",
      "import": "./dist/server/mcp.js"
    }
  },
  "files": [
    "dist",
    "scripts/rea-captcha.mjs",
    "examples",
    "python/pyproject.toml",
    "python/README.md",
    "python/src/rea_captcha/__init__.py",
    "python/src/rea_captcha/detector.py",
    "python/src/rea_captcha/ocr_worker.py",
    "python/src/rea_captcha/plugin.py",
    "models",
    "skills",
    "docs",
    "README.md",
    "DISCLAIMER.md",
    "THIRD_PARTY_NOTICES.md",
    "MODEL_LICENSES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-skill.mjs && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run test && npm run test:python && npm run docs:check",
    "docs:check": "node scripts/check-doc-links.mjs",
    "demo:web": "node examples/web-demo/server.mjs",
    "mcp-registry:check": "node scripts/verify-mcp-registry.mjs",
    "prepack": "npm run build",
    "record:web-demo": "npm run build && node scripts/record-web-demos.mjs",
    "start": "node scripts/rea-captcha.mjs mcp",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s python/tests -p 'test_*.py' -v",
    "test:browser": "vitest run tests/playwright-handoff.test.ts",
    "test:package": "node scripts/verify-package-install.mjs",
    "test:web-demo": "npm run build && node scripts/verify-web-demo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "1.63.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "browser-agent",
    "captcha",
    "human-handoff",
    "jet-browser",
    "mcp",
    "playwright",
    "verification-challenge"
  ]
}
